BUYER_PRIVATE_KEY=
REACTIVE_FUNDING_ETH=1
CALLBACK_FUNDING_ETH=0.003
THRESHOLD_BPS=6500
CONFIRMATIONS=5
POLL_MS=2000
DEPLOYMENT_FILE=.state/deployment.json
PORT=3000
