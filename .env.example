# Testnet ONLY. Never commit a real .env or share keys in chat.
# Origin chain: Ethereum Sepolia (11155111) or Base Sepolia (84532). BASE_RPC_URL is also accepted.
ORIGIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev
# Dedicated funded testnet deployer. Owns both deployments; never use a mainnet wallet.
DEPLOYER_PRIVATE_KEY=
# Separate testnet account for the AI reporter (recommended).
REPORTER_PRIVATE_KEY=
# Set reporter address before deploying; must match REPORTER_PRIVATE_KEY.
REPORTER_ADDRESS=
# Required only for open-escrow.mjs and buyer release/refund operations.
BUYER_PRIVATE_KEY=
REACTIVE_FUNDING_ETH=1
CALLBACK_FUNDING_ETH=0.003
THRESHOLD_BPS=6500
# Size-aware policy: stricter threshold for deposits >= HIGH_VALUE_ETH (defaults disable it)
HIGH_VALUE_THRESHOLD_BPS=5000
HIGH_VALUE_ETH=0.001
# Optional: SELLER_ADDRESS for scripts/live-run.mjs
SELLER_ADDRESS=
CONFIRMATIONS=2
POLL_MS=2000
DEPLOYMENT_FILE=.state/deployment.json
PORT=3000
